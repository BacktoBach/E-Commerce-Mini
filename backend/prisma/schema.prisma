generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ORDER_STAFF
  SHIPPER
  ADMIN
}

enum AdministrativeUnitType {
  CITY
  WARD
  COMMUNE
  SPECIAL_ZONE
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique @db.VarChar(320)
  username     String?   @unique @db.VarChar(50)
  fullName     String?   @map("full_name") @db.VarChar(120)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(2048)
  phone        String?   @db.VarChar(20)
  role         Role      @default(CUSTOMER)
  isBlocked    Boolean   @default(false) @map("is_blocked")
  blockReason  String?   @map("block_reason") @db.VarChar(500)
  blockedAt    DateTime? @map("blocked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses Address[]

  @@map("users")
}

model Address {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @map("user_id") @db.Uuid
  label                  String?                @db.VarChar(50)
  receiverName           String                 @map("receiver_name") @db.VarChar(120)
  receiverPhone          String                 @map("receiver_phone") @db.VarChar(20)
  addressText            String                 @map("address_text") @db.VarChar(500)
  formattedAddress       String                 @map("formatted_address") @db.VarChar(500)
  administrativeUnitCode String                 @map("administrative_unit_code") @db.VarChar(16)
  administrativeUnitName String                 @map("administrative_unit_name") @db.VarChar(160)
  administrativeUnitType AdministrativeUnitType @map("administrative_unit_type")
  latitude               Decimal                @db.Decimal(9, 6)
  longitude              Decimal                @db.Decimal(9, 6)
  isDefault              Boolean                @default(false) @map("is_default")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([administrativeUnitCode])
  @@map("addresses")
}
